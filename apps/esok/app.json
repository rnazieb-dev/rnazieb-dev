{
  "expo": {
    "name": "NAFS App",
    "slug": "hari-ini",
    "scheme": "esok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.rnazieb.esok",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Esok memakai Face ID untuk membuka amalan rahasia Anda.",
        "NSLocationWhenInUseUsageDescription": "Lokasi dipakai hanya untuk menghitung waktu salat bagi pengingat. Tidak dikirim ke server."
      }
    },
    "android": {
      "package": "dev.rnazieb.esok",
      "adaptiveIcon": {
        "backgroundColor": "#0F2A2A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F2A2A",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0F2A2A"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#0F2A2A"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Esok memakai Face ID untuk membuka amalan rahasia Anda."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lokasi dipakai hanya untuk menghitung waktu salat bagi pengingat."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "4692677f-c617-4b96-8545-f4d666460e69"
      }
    }
  }
}
